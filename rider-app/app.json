{
  "expo": {
    "name": "GhanaDash Rider",
    "slug": "ghanadash-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ghanadash-rider",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ghanadash.rider"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.ghanadash.rider",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "d050d3ed-baaf-49d0-b629-14c7bc7fac95"
      }
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
