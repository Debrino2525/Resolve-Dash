{
  "expo": {
    "name": "GhanaDash Rider",
    "slug": "ghanadash-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "ghanadash-rider",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ghanadash.rider",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GhanaDash uses the microphone only during in-app calls between a customer and their rider."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D121A"
      },
      "package": "com.ghanadash.rider",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "d050d3ed-baaf-49d0-b629-14c7bc7fac95"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "GhanaDash needs your photos to upload your rider documents and to send delivery photos in chat.",
          "cameraPermission": "GhanaDash uses the camera for your rider documents and for delivery photos in chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GhanaDash shows your position on the map and guides you to pickups and drop-offs while you are on duty.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "GhanaDash uses the microphone only during in-app calls between a customer and their rider."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0D121A"
        }
      ]
    ],
    "icon": "./assets/images/icon.png"
  }
}
