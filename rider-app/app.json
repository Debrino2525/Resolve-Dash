{
  "expo": {
    "name": "GhanaDash Rider",
    "slug": "ghanadash-rider",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "ghanadash-rider",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ghanadash.rider",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GhanaDash uses the microphone only during in-app calls between a customer and their rider."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D121A"
      },
      "package": "com.ghanadash.rider",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "GhanaDash needs your photos to upload your rider documents and to send delivery photos in chat.",
          "cameraPermission": "GhanaDash uses the camera for your rider documents and for delivery photos in chat.",
          "microphonePermission": "GhanaDash uses the microphone only during in-app calls between a customer and their rider."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GhanaDash shows your position on the map and guides you to pickups and drop-offs while you are on duty.",
          "locationAlwaysAndWhenInUsePermission": "While you are online or on a delivery, GhanaDash shares your location even when your screen is off, so you keep getting orders and your customer can follow their package. It stops when you go offline.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "GhanaDash uses the microphone only during in-app calls between a customer and their rider."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0D121A"
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-notifications",
        {
          "color": "#00C853",
          "sounds": [
            "./assets/sounds/new-order.wav",
            "./assets/sounds/ring.wav"
          ]
        }
      ]
    ],
    "icon": "./assets/images/icon.png",
    "owner": "resolvedash",
    "extra": {
      "eas": {
        "projectId": "e934b098-16f8-4e65-8581-7c9cf77d5816"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e934b098-16f8-4e65-8581-7c9cf77d5816"
    }
  }
}
