{
  "expo": {
    "name": "GhanaDash Rider",
    "slug": "ghanadash-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "ghanadash-rider",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ghanadash.rider"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.ghanadash.rider",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "d050d3ed-baaf-49d0-b629-14c7bc7fac95"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "GhanaDash needs your photos so you can upload your Ghana Card, licence, roadworthy and insurance documents for verification.",
          "cameraPermission": "GhanaDash uses the camera so you can photograph your Ghana Card, licence, roadworthy and insurance documents for verification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GhanaDash shows your position on the map and guides you to pickups and drop-offs while you are on duty.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
