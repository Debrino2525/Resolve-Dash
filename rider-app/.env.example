# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL and anon/publishable key (safe to expose to client)
EXPO_PUBLIC_SUPABASE_URL=https://tllhlkpeepkopzxvxhvc.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# ── Backend API ───────────────────────────────────────────────────────────────
# Expo Go on a physical device: set this to your machine's local IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
# Find your IP with: ipconfig (Windows) | ifconfig (Mac/Linux)
# Production:
#   EXPO_PUBLIC_API_URL=https://api.ghanadash.com
EXPO_PUBLIC_API_URL=http://localhost:3000
