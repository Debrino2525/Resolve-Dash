# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Project Configuration (Dev Project: https://tllhlkpeepkopzxvxhvc.supabase.co)
SUPABASE_URL=https://tllhlkpeepkopzxvxhvc.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database Configuration (Direct Connection / Session Pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Or direct: postgresql://postgres:[password]@db.tllhlkpeepkopzxvxhvc.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_db_password_here@db.tllhlkpeepkopzxvxhvc.supabase.co:5432/postgres
DB_POOL_MAX=10

# Database TLS. Verify the server certificate in production (prevents MITM):
#   Supabase Dashboard → Project Settings → Database → SSL Configuration → Download certificate
# DATABASE_SSL_CA accepts the PEM text (\n escapes allowed) or a path to the .crt/.pem file.
# With NODE_ENV=production the server refuses to start without it, unless you explicitly set
# DATABASE_SSL_REJECT_UNAUTHORIZED=false. DATABASE_SSL=false disables TLS (local Postgres only).
DATABASE_SSL_CA=./certs/supabase-ca.crt
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Test Database Configuration
# MUST be a separate database, NEVER point to production or shared development data.
TEST_DATABASE_URL=postgresql://postgres:your_test_db_password_here@localhost:5432/ghana_delivery_test?sslmode=disable

# Paystack Payment Gateway Integration
# In test mode: sk_test_... | In live mode: sk_live_...
# NEVER commit the actual secret key to version control or logs.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co
# Production: the API's own HTTPS return bridge (always used in production; required).
PAYSTACK_CALLBACK_URL=https://ghanadash-api.globitechcybersolutions.com/subscriptions/callback

# Rider Subscription Settings (Fully Configurable)
# Base price in integer pesewas: 5000 pesewas = 50.00 GHS
SUBSCRIPTION_PRICE_PESEWAS=5000
SUBSCRIPTION_CURRENCY=GHS
SUBSCRIPTION_PERIOD_DAYS=7

# Trial duration in days. Configurable per environment or promotional campaign.
TRIAL_PERIOD_DAYS=14

# Grace duration in hours before full suspension takes effect
GRACE_PERIOD_HOURS=24

# Reminder milestones in hours before expiry (comma-separated integers)
REMINDER_WINDOW_HOURS=24,2

# Security & Rate Limiting
# Max request body size for webhooks and APIs (100kb default)
MAX_BODY_SIZE_BYTES=102400
# Per-IP rate limits per THROTTLE_TTL_MS window. THROTTLE_LIMIT applies to every route
# (the admin page alone polls ~8 times a minute); AUTH_THROTTLE_LIMIT applies to admin login.
# Paystack webhooks are never throttled.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5
# Set when running behind a reverse proxy / load balancer so rate limits key on the real client
# IP instead of the proxy's: a hop count (usually 1) or an Express "trust proxy" value.
# TRUST_PROXY=1

# ── Rider phone verification (SMS OTP via mNotify / BMS API v2) ──────────────
# Docs: https://developer.bms.africa/  (Quick Bulk SMS: POST /api/sms/quick)
# The sender ID must be approved in mNotify AS AN OTP SENDER ID (registered with an otp_url),
# otherwise mNotify rejects OTP messages. Max 11 characters.
# Without these, development prints codes to the server log; production refuses to start.
MNOTIFY_API_KEY=your_mnotify_api_key_here
MNOTIFY_SENDER_ID=GhanaDash
# HMAC secret for the short-lived "phone verified" proof. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_VERIFICATION_SECRET=replace_with_64_hex_chars
# Onboarding only accepts an SMS-verified phone. Set false only for emergencies/testing.
REQUIRE_VERIFIED_PHONE=true

# ── Deliveries (customer orders + live dispatch) ─────────────────────────────
# HMAC secret for signed price quotes. Required in production (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_QUOTE_SECRET=replace_with_64_hex_chars
# Mapbox token for road distance (pricing). Use a separate SECRET-scoped token (sk.*) or a
# pk.* token restricted to Directions; never the same unrestricted token shipped in the apps.
MAPBOX_ACCESS_TOKEN=your_mapbox_token
# Fares in pesewas: base + per km by road. Defaults GH₵18.00 + GH₵1.25/km.
FARE_BASE_PESEWAS=1800
FARE_PER_KM_PESEWAS=125
# Stops the dispatch loop (tests/maintenance only). Production refuses to start with "true".
# DISPATCH_DISABLED=false

# ── Production hosting ───────────────────────────────────────────────────────
# Serve the admin portal only on this hostname (and redirect its "/" to /admin).
# ADMIN_HOST=ghanadash-admin.globitechcybersolutions.com
# With Cloudflare Access in front of ADMIN_HOST, the server also verifies Access's signed pass
# (header Cf-Access-Jwt-Assertion) and answers 403 without it. Team domain from the Access login
# URL; AUD = the Access application's "Application Audience (AUD) Tag". Not secrets.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# Staging only: allow a Paystack sk_test_ key while NODE_ENV=production.
# ALLOW_PAYSTACK_TEST_KEY=false

# Google Places API (New) for pickup/drop-off search. Optional: without it the apps fall back
# to Mapbox search. Server-side only; restrict the key to "Places API (New)".
# GOOGLE_PLACES_API_KEY=your_google_places_key
