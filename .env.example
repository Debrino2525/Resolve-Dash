# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Project Configuration (Dev Project: https://tllhlkpeepkopzxvxhvc.supabase.co)
SUPABASE_URL=https://tllhlkpeepkopzxvxhvc.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database Configuration (Direct Connection / Session Pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Or direct: postgresql://postgres:[password]@db.tllhlkpeepkopzxvxhvc.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_db_password_here@db.tllhlkpeepkopzxvxhvc.supabase.co:5432/postgres
DB_POOL_MAX=10

# Database TLS. Verify the server certificate in production (prevents MITM):
#   Supabase Dashboard → Project Settings → Database → SSL Configuration → Download certificate
# DATABASE_SSL_CA accepts the PEM text (\n escapes allowed) or a path to the .crt/.pem file.
# With NODE_ENV=production the server refuses to start without it, unless you explicitly set
# DATABASE_SSL_REJECT_UNAUTHORIZED=false. DATABASE_SSL=false disables TLS (local Postgres only).
DATABASE_SSL_CA=./certs/supabase-ca.crt
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Test Database Configuration
# MUST be a separate database, NEVER point to production or shared development data.
TEST_DATABASE_URL=postgresql://postgres:your_test_db_password_here@localhost:5432/ghana_delivery_test?sslmode=disable

# Paystack Payment Gateway Integration
# In test mode: sk_test_... | In live mode: sk_live_...
# NEVER commit the actual secret key to version control or logs.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://api.example.com/subscriptions/callback

# Rider Subscription Settings (Fully Configurable)
# Base price in integer pesewas: 5000 pesewas = 50.00 GHS
SUBSCRIPTION_PRICE_PESEWAS=5000
SUBSCRIPTION_CURRENCY=GHS
SUBSCRIPTION_PERIOD_DAYS=7

# Trial duration in days. Configurable per environment or promotional campaign.
TRIAL_PERIOD_DAYS=14

# Grace duration in hours before full suspension takes effect
GRACE_PERIOD_HOURS=24

# Reminder milestones in hours before expiry (comma-separated integers)
REMINDER_WINDOW_HOURS=24,2

# Security & Rate Limiting
# Max request body size for webhooks and APIs (100kb default)
MAX_BODY_SIZE_BYTES=102400
# Per-IP rate limits per THROTTLE_TTL_MS window. THROTTLE_LIMIT applies to every route
# (the admin page alone polls ~8 times a minute); AUTH_THROTTLE_LIMIT applies to admin login.
# Paystack webhooks are never throttled.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5
# Set when running behind a reverse proxy / load balancer so rate limits key on the real client
# IP instead of the proxy's: a hop count (usually 1) or an Express "trust proxy" value.
# TRUST_PROXY=1
