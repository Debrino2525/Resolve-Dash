{
  "expo": {
    "name": "GhanaDash",
    "slug": "ghanadash",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ghanadash",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ghanadash.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "GhanaDash uses the microphone only during in-app calls between a customer and their rider."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D121A"
      },
      "package": "com.ghanadash.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GhanaDash uses your location to fill in your pickup address and show riders near you.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "GhanaDash uses your photos so you can show the rider your package or the pickup spot.",
          "cameraPermission": "GhanaDash uses the camera so you can photograph your package or the pickup spot for the rider.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0D121A"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "GhanaDash uses the microphone only during in-app calls between a customer and their rider."
        }
      ],
      "@rnmapbox/maps"
    ],
    "icon": "./assets/images/icon.png",
    "owner": "resolvedash",
    "extra": {
      "eas": {
        "projectId": "a3bc4600-94d3-43ab-88ec-09b0ad355e97"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a3bc4600-94d3-43ab-88ec-09b0ad355e97"
    }
  }
}
